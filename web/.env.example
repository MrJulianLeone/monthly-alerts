# Neon Postgres (require SSL)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# OpenAI — gpt-4o-mini translates checklist content and triages the support
# inbox (spam quarantine + auto-replies); without it inbound mail is stored
# unclassified
OPENAI_API_KEY=sk-...

# Resend — magic links, invitations, monthly status emails
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alerts@alerts.monthlyalerts.com   # must be on the Resend-verified domain
RESEND_FROM_NAME=MonthlyAlerts

# Support inbox — inbound mail via Resend (email.received webhook -> /api/webhooks/resend).
# Requires: monthlyalerts.com verified as a Resend domain (for sending from support@),
# an MX record on monthlyalerts.com pointing at Resend inbound, and a webhook
# subscribed to email.received. The signing secret is on the webhook's page.
SUPPORT_EMAIL=support@monthlyalerts.com
RESEND_WEBHOOK_SECRET=whsec_...

# Stripe — per-project fee, disabled until BILLING_ENABLED=true
BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...                            # one-time price per project
STRIPE_EXTENSION_PRICE_ID=price_...                  # +2-year storage extension (unset = extensions hidden)

# Vercel Blob — item photos + the per-project PDF file cabinet (create a Blob store in Vercel)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Sentry — error tracking; leave unset to disable (no-op without a DSN)
SENTRY_DSN=https://...@....ingest.sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...

# App
NEXT_PUBLIC_APP_URL=https://monthlyalerts.com

# Vercel cron auth (monthly status emails) — also used to sign unsubscribe links
CRON_SECRET=long-random-string

# Protects POST /api/admin/migrate (run schema against prod without a local psql)
MIGRATE_SECRET=another-long-random-string

# Prospecting outreach — dedicated Gmail mailbox on a SEPARATE domain (never
# Resend / monthlyalerts.com). Full walkthrough at /admin/prospects/setup;
# mint the refresh token with scripts/gmail-token.mjs. Unset = the pipeline
# researches and drafts, but nothing sends.
OUTREACH_GOOGLE_CLIENT_ID=....apps.googleusercontent.com
OUTREACH_GOOGLE_CLIENT_SECRET=GOCSPX-...
OUTREACH_GOOGLE_REFRESH_TOKEN=1//...
OUTREACH_FROM_NAME=Julian                            # From display name + email sign-off
